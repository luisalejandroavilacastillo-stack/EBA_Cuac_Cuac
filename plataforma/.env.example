# Copie este archivo como .env y ajuste los valores. El archivo .env nunca se sube al repositorio.
#
# PRODUCCIÓN (servidor del ICA): la API no arranca si falta alguno de estos puntos.
#   NODE_ENV=produccion
#   INGRESO_DEMOSTRACION=no           sin el ingreso de demostración
#   DATOS_EJEMPLO=no                  la plataforma arranca sin los datos de ejemplo
#   DB_CLAVE y DB_CLAVE_ROOT          claves propias (no las de ejemplo)
#   PUBLICO_URL=https://…             la dirección real (no localhost)
#   COOKIE_SEGURA=si                  con https
#   ADMIN_CORREO=…                    correo del primer administrador (recibe el enlace para crear su contraseña)
#   CORREO_HOST, CORREO_USUARIO, …    correo institucional

# Entorno: desarrollo | produccion
NODE_ENV=desarrollo

# Backend (Node.js + Express)
# API_HOST: IP donde escucha la API. 0.0.0.0 = todas las IP del equipo (localhost y la IP de la red).
#           Si quiere que escuche solo en una IP, escríbala aquí (por ejemplo 192.168.1.20).
API_HOST=0.0.0.0
API_PUERTO=3085
# WEB_ORIGEN: direcciones desde donde se abre el frontend Angular, separadas por coma.
#             Agregue la IP del equipo si va a entrar desde otro computador o celular,
#             por ejemplo: http://localhost:4200,http://192.168.1.20:4200
WEB_ORIGEN=http://localhost:4200

# Puerto del frontend cuando corre en Docker (Nginx). Abra http://localhost:4200 o http://SU_IP:4200
WEB_PUERTO=4200

# Base de datos MariaDB (la crea docker compose con estos datos)
DB_HOST=localhost
DB_PUERTO=3306
DB_NOMBRE=eba
DB_USUARIO=eba_app
DB_CLAVE=cambie_esta_clave
DB_CLAVE_ROOT=cambie_esta_clave_root

# Datos de ejemplo del prototipo (fincas, inspecciones y usuarios de demostración) cuando la base está vacía.
# si = se cargan la primera vez (desarrollo) · no = la plataforma arranca vacía (producción).
DATOS_EJEMPLO=si

# ---------------------------------------------------------------------------------------------
# Ingreso real (módulo 1): contraseña cifrada, código de 6 dígitos al correo y enlaces de activación.
# ---------------------------------------------------------------------------------------------
# Dirección con la que las personas abren la plataforma (va en los enlaces de los correos).
# En el servidor del ICA, por ejemplo: https://eba.ica.gov.co
PUBLICO_URL=http://localhost:4200
# Ingreso de demostración del prototipo (perfil, Ica2026* y 482073). si = desarrollo · no = producción (OBLIGATORIO en producción).
INGRESO_DEMOSTRACION=si
# si cuando la plataforma se abre con https:// (la cookie de sesión solo viaja cifrada).
COOKIE_SEGURA=no
# Minutos sin uso para cerrar la sesión (RF01).
SESION_MINUTOS=15

# Primer administrador: si no hay ninguno con la cuenta activada, se crea con estos datos y recibe en su correo
# el enlace para crear su contraseña. En desarrollo, si se deja vacío, se usa la cuenta de ejemplo a.rojas@ica.gov.co.
ADMIN_CORREO=
ADMIN_NOMBRE=Administrador EBA
ADMIN_DOCUMENTO=1000000001

# Correo que envía los códigos y enlaces.
# Desarrollo: Mailpit (incluido en docker compose). Los correos NO salen a internet: se ven en http://localhost:8025
# Producción: los datos del correo institucional (los da el área de sistemas del ICA). Ejemplos:
#   Outlook / Microsoft 365: CORREO_HOST=smtp.office365.com  CORREO_PUERTO=587  CORREO_SEGURO=no
#   Gmail institucional:     CORREO_HOST=smtp.gmail.com      CORREO_PUERTO=465  CORREO_SEGURO=si
# La clave del correo solo se escribe aquí (este archivo nunca se sube a GitHub).
CORREO_HOST=mailpit
CORREO_PUERTO=1025
CORREO_SEGURO=no
CORREO_USUARIO=
CORREO_CLAVE=
CORREO_REMITENTE=EBA Cuac Cuac <no-responder@eba.local>

# Asistente de la norma con IA: Gemini (opcional). Déjelo vacío para usar el modo local.
# La clave se crea en Google AI Studio (aistudio.google.com › Get API key). Escríbala sin comillas ni espacios.
# Solo vive aquí, en el servidor; nunca llega al navegador. El servidor quita los datos personales antes de enviar cada pregunta.
GEMINI_API_KEY=
GEMINI_MODELO=gemini-3.8-flash
# Modelo que se usa si el principal está saturado (error 503).
GEMINI_MODELO_RESPALDO=gemini-3.5-flash-lite
