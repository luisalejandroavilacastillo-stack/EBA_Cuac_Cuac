{
  "$schema": "../../node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "aplicacion",
      "installMode": "prefetch",
      "resources": { "files": ["/favicon.ico", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js"] }
    },
    {
      "name": "recursos",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": { "files": ["/**/*.(svg|png|jpg|webp|woff|woff2|ttf)"] }
    },
    {
      "name": "norma-pdf",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": { "files": ["/norma/*.pdf"] }
    }
  ],
  "navigationUrls": ["/**", "!/**/*.*", "!/**/*__*", "!/**/*__*/**", "!/api/**"]
}
