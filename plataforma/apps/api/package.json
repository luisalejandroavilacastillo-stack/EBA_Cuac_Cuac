{
  "name": "@eba/api",
  "version": "0.6.0",
  "description": "API de la plataforma EBA Cuac Cuac (Node.js + Express)",
  "private": true,
  "type": "module",
  "main": "src/EBA_patosgansos.js",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=../../.env src/EBA_patosgansos.js",
    "dev": "node --watch --env-file-if-exists=../../.env src/EBA_patosgansos.js",
    "test": "node --env-file-if-exists=../../.env --test \"test/**/*.test.js\"",
    "db:migrar": "node --env-file-if-exists=../../.env -e \"import('./src/bd/migraciones.js').then(m=>m.aplicarMigraciones())\""
  },
  "dependencies": {
    "@eba/norma": "0.1.0",
    "express": "^5.3.0",
    "mariadb": "^3.5.5"
  }
}
