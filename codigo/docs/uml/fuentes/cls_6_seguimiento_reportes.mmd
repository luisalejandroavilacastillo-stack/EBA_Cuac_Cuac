%% Vista 6 · Asignación, aprobación, seguimiento, constancia, reportes y tablero · v0.25
classDiagram
  class ProcesoSeguimiento {
    +id PRC
    +visitas
    +usados
    +max
    +estado
    +ampliado
    +estadoProceso(pid)
    +ampliarProceso(pid, motivo)
  }
  class EstadoProceso {
    <<enumeration>>
    En curso
    Seguimiento programado
    En seguimiento
    Requiere ampliación
    Cumplido
    Cerrado sin cumplir
  }
  class ReglaCumplimiento {
    +puntajeMin 90
    +sinCeros
    +sinPendientes
    +verificarCumplimiento(ev)
  }
  class Programacion {
    +fechaSugeridaSeguimiento(ev)
    +avisoFechaSeguimiento(ev, fecha)
    +programarSeguimiento(pid, fecha, inspector)
    +reprogramarSeguimiento(ev, fecha, motivo)
    +crearSeguimiento(pid, inspector)
    +crearProceso(finca, sp, base, fecha, inspector)
  }
  class Flujo {
    +ESTADOS_FLUJO Por asignar…Aprobada
    +ESTADOS_PRODUCTOR
    +textoFlujo(s)
    +enHistorial(ev)
    +estadoEspecie(f, sp)
    +pasoContinuar(ev)
    +siguientePendiente(ev)
    +contarEstados(fs)
  }
  class vInicio {
    <<vista solo lectura>>
    +KPI
    +MiTrabajo
    +TareasPendientes
    +graficas
  }
  class vReportes {
    <<vista>>
    +filtros
    +csvSinDatosPersonales
    +imprimir
    +compararVisitas()
  }
  class Asignacion {
    +por
    +fecha
    +inspector
    +fechaVisita
    +anterior
  }
  class Revision {
    +accion Enviada|Reenviada|Devuelta|Aprobada
    +por
    +fecha
    +obs
  }
  class Reprogramacion {
    +antes
    +nueva
    +motivo
    +por
  }
  class Constancia {
    +codigo CER-AAAA-NNNNN
    +verificacion
    +emitida
    +vence
    +emitirConstancia(ev)
    +constanciaVigente(c)
  }
  class Bitacora {
    +t
    +u
    +accion
    +log(accion)
  }
  ProcesoSeguimiento --> EstadoProceso
  ProcesoSeguimiento ..> ReglaCumplimiento
  Programacion ..> ProcesoSeguimiento
  Programacion ..> Bitacora
  Flujo ..> ProcesoSeguimiento
  vInicio ..> Flujo
  vReportes ..> ProcesoSeguimiento
  Programacion ..> Asignacion
  Programacion ..> Reprogramacion
  Revision ..> Constancia : Aprobada y cumple
  Revision ..> Programacion : Aprobada sin cumplir
