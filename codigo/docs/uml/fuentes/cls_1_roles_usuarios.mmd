%% Vista 1 · Roles y usuarios (RF02, RF03) · v0.25
classDiagram
  class Perfil {
    <<enumeration>>
    inspector
    coordinador
    productor
    admin
  }
  class Usuario {
    +clave
    +nombre
    +perfil
    +tipoDoc
    +doc
    +correo_unico
    +tel
    +estado Activo|Inactivo
    +creado_por_fecha
    +completarUsuario()
  }
  class Permisos {
    +PERMISOS: Map~Perfil, Modulo[]~
    +puede(sec)
    +esGestor()
    +puedeEvaluar(ev)
    +puedeVerEval(ev)
  }
  class Sesion {
    +rol perfil
    +u clave del usuario
    +desde
    +iniciarSesion(clave)
    +yo() Usuario
  }
  class Aviso {
    +para usuario o perfil
    +txt
    +href
    +tipo
    +leido
    +avisar(para, txt, href, tipo)
    +misAvisos()
  }
  class vUsuarios {
    <<vista>>
    +crearUsuario()
    +editar(perfil)
    +inactivarOReactivar()
    +eliminarSinHistorial()
    +vincularFincas(productor)
  }
  Usuario --> Perfil
  Sesion --> Usuario
  Permisos --> Perfil
  Aviso ..> Usuario
  vUsuarios ..> Usuario
  note for Permisos "Coordinador: fincas, asignar, aprobar o devolver, seguimientos\nAdministrador: todo menos aprobar o devolver\nInspector: solo lo asignado\nProductor: sus fincas y lo aprobado"
