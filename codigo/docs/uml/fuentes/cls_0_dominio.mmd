%% Modelo de dominio v0.25 (vista general)
classDiagram
  direction LR
  class Usuario {
    +nombre
    +perfil
    +documento
    +correo
    +estado
  }
  class Constancia {
    +codigo
    +verificacion
    +vence
  }
  class Revision {
    +accion
    +por
    +obs
  }
  class Aviso {
    +para
    +txt
    +tipo
  }
  class Finca {
    +id FIN-AAAA-NNNNN
    +nombre
    +depto
    +mpio
    +vereda
    +area
    +estado ACTIVA|INACTIVA
  }
  class PersonaResponsable {
    +nombre
    +tipoDoc
    +doc
    +correo
    +tel
    +autoriza
  }
  class EspecieFinca {
    +sp pato|ganso
    +proposito
    +sistema
    +conCorral
    +permanencia
    +cama
    +bebedero
  }
  class LoteInventario {
    +cat
    +n
    +edad
    +peso
  }
  class ProcesoSeguimiento {
    +id PRC
    +estado
    +max 3..5
    +ampliado
  }
  class Evaluacion {
    +id EVA
    +fecha
    +estado
    +visita
    +pobEsp
    +segFecha propuesta
    +inspector
    +asignacion
    +aprobada
  }
  class Respuesta {
    +code
    +total
    +part
    +extra
    +porPunto
    +g
  }
  class RecorridoGanso {
    +aves
    +pts
    +gal
    +trat
  }
  class PlanMejora {
    +accion
    +responsable
    +plazo
  }
  class Firma {
    +rol
    +nombre
    +fecha
  }
  class Indicador {
    +code
    +sp
    +medida MBA|MBR|MBG
    +numeral
    +tabla
    +regla
  }
  class Bitacora {
    +t
    +u
    +accion
  }
  Usuario "1" --> "*" Finca : registra (coordinador, admin)
  Usuario "1" --> "*" Evaluacion : asignada a (inspector)
  Evaluacion "1" *-- "*" Revision : enviar, devolver, aprobar
  Evaluacion "1" *-- "0..1" Constancia : si cumple al aprobar
  Usuario "1" --> "*" Aviso
  Finca "1" *-- "1" PersonaResponsable
  Finca "1" *-- "1..2" EspecieFinca
  EspecieFinca "1" *-- "*" LoteInventario
  Finca "1" --> "*" ProcesoSeguimiento : por especie
  ProcesoSeguimiento "1" *-- "1..6" Evaluacion : visita 0 + seguimientos
  Evaluacion "1" *-- "*" Respuesta
  Evaluacion "1" *-- "0..1" RecorridoGanso
  Evaluacion "1" *-- "*" PlanMejora
  Evaluacion "1" *-- "*" Firma
  Respuesta "*" --> "1" Indicador
  Evaluacion ..> Evaluacion : base / anterior
  Usuario "1" --> "*" Bitacora
