digraph ER {
graph [rankdir=LR, fontname="Arial", fontsize=18, labelloc=t, nodesep=0.35, ranksep=0.9, pad=0.3, bgcolor="#F5F5F5",
       label=<<B>Modelo entidad-relación · Seguimiento, reportes y control (RF27–RF36, RF40, Vista 6)</B><BR/><FONT POINT-SIZE="11">PK clave primaria · FK clave foránea · * obligatorio · pata de gallo = muchos · barra = uno · círculo = opcional · esquema eba (PostgreSQL)</FONT>>];
node [shape=plain, fontname="Arial", fontsize=10];
edge [color="#3C4043", penwidth=1.1];
"plan_mejora" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#745E35" PORT="tabla"><FONT COLOR="white"><B>plan_mejora</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT POINT-SIZE="8" COLOR="#5B6660">PK</FONT></TD><TD ALIGN="LEFT"><B>id</B> *</TD><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#5B6660">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT POINT-SIZE="8" COLOR="#5B6660">FK</FONT></TD><TD ALIGN="LEFT"><I>evaluacion_id</I> *</TD><TD ALIGN="LEFT" PORT="evaluacion_id"><FONT COLOR="#5B6660">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"> </TD><TD ALIGN="LEFT">fecha_acuerdo *</TD><TD ALIGN="LEFT" PORT="fecha_acuerdo"><FONT COLOR="#5B6660">date</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"> </TD><TD ALIGN="LEFT">estado *</TD><TD ALIGN="LEFT" PORT="estado"><FONT COLOR="#5B6660">estado_plan</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT POINT-SIZE="8" COLOR="#5B6660">FK</FONT></TD><TD ALIGN="LEFT"><I>cerrado_por_evaluacion</I></TD><TD ALIGN="LEFT" PORT="cerrado_por_evaluacion"><FONT COLOR="#5B6660">integer</FONT></TD></TR></TABLE>>];
