digraph ER {
graph [rankdir=LR, fontname="Arial", fontsize=18, labelloc=t, nodesep=0.35, ranksep=0.9, pad=0.3, bgcolor="#F5F5F5",
       label=<<B>Modelo entidad-relación · Asistente de la norma (RF24, RF25, Vista 7)</B><BR/><FONT POINT-SIZE="11">PK clave primaria · FK clave foránea · * obligatorio · pata de gallo = muchos · barra = uno · círculo = opcional · esquema eba (PostgreSQL)</FONT>>];
node [shape=plain, fontname="Arial", fontsize=10];
edge [color="#3C4043", penwidth=1.1];
"configuracion_asistente" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#2B6CB0" PORT="tabla"><FONT COLOR="white"><B>configuracion_asistente</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT POINT-SIZE="8" COLOR="#5B6660">PK</FONT></TD><TD ALIGN="LEFT"><B>id</B> *</TD><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#5B6660">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"> </TD><TD ALIGN="LEFT">modo *</TD><TD ALIGN="LEFT" PORT="modo"><FONT COLOR="#5B6660">varchar(5)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"> </TD><TD ALIGN="LEFT">modelo</TD><TD ALIGN="LEFT" PORT="modelo"><FONT COLOR="#5B6660">varchar(60)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"> </TD><TD ALIGN="LEFT">referencia_clave</TD><TD ALIGN="LEFT" PORT="referencia_clave"><FONT COLOR="#5B6660">varchar(120)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT POINT-SIZE="8" COLOR="#5B6660">FK</FONT></TD><TD ALIGN="LEFT"><I>actualizado_por</I></TD><TD ALIGN="LEFT" PORT="actualizado_por"><FONT COLOR="#5B6660">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"> </TD><TD ALIGN="LEFT">actualizado_en *</TD><TD ALIGN="LEFT" PORT="actualizado_en"><FONT COLOR="#5B6660">timestamptz</FONT></TD></TR></TABLE>>];
"consulta_asistente" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#2B6CB0" PORT="tabla"><FONT COLOR="white"><B>consulta_asistente</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT POINT-SIZE="8" COLOR="#5B6660">PK</FONT></TD><TD ALIGN="LEFT"><B>id</B> *</TD><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#5B6660">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT POINT-SIZE="8" COLOR="#5B6660">FK</FONT></TD><TD ALIGN="LEFT"><I>usuario_id</I> *</TD><TD ALIGN="LEFT" PORT="usuario_id"><FONT COLOR="#5B6660">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"> </TD><TD ALIGN="LEFT">rol *</TD><TD ALIGN="LEFT" PORT="rol"><FONT COLOR="#5B6660">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"> </TD><TD ALIGN="LEFT">pantalla</TD><TD ALIGN="LEFT" PORT="pantalla"><FONT COLOR="#5B6660">varchar(60)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"> </TD><TD ALIGN="LEFT">tema</TD><TD ALIGN="LEFT" PORT="tema"><FONT COLOR="#5B6660">varchar(30)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"> </TD><TD ALIGN="LEFT">modo *</TD><TD ALIGN="LEFT" PORT="modo"><FONT COLOR="#5B6660">varchar(5)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"> </TD><TD ALIGN="LEFT">dentro_tema *</TD><TD ALIGN="LEFT" PORT="dentro_tema"><FONT COLOR="#5B6660">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"> </TD><TD ALIGN="LEFT">realizada_en *</TD><TD ALIGN="LEFT" PORT="realizada_en"><FONT COLOR="#5B6660">timestamptz</FONT></TD></TR></TABLE>>];
"usuario" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#8A8F98" PORT="tabla"><FONT COLOR="white"><B>usuario</B></FONT></TD></TR><TR><TD COLSPAN="3"><FONT COLOR="#5B6660">otro módulo</FONT></TD></TR></TABLE>>];
"configuracion_asistente":"actualizado_por":e -> "usuario":"tabla":w [arrowhead=teeodot, arrowtail=crowodot, dir=both];
"consulta_asistente":"usuario_id":e -> "usuario":"tabla":w [arrowhead=teetee, arrowtail=crowodot, dir=both];
}