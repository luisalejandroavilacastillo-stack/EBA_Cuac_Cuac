digraph ER {
graph [rankdir=LR, fontname="Arial", fontsize=18, labelloc=t, nodesep=0.35, ranksep=0.9, pad=0.3, bgcolor="#F5F5F5",
       label=<<B>Modelo entidad-relación · Unidades productivas y catálogos (RF05–RF08, RF35, Vista 3)</B><BR/><FONT POINT-SIZE="11">PK clave primaria · FK clave foránea · * obligatorio · pata de gallo = muchos · barra = uno · círculo = opcional · esquema eba (PostgreSQL)</FONT>>];
