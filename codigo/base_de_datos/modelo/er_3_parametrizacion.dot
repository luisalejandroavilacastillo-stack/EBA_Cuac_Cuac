digraph ER {
graph [rankdir=LR, fontname="Arial", fontsize=18, labelloc=t, nodesep=0.35, ranksep=0.9, pad=0.3, bgcolor="#F5F5F5",
       label=<<B>Modelo entidad-relación · Parametrización de la metodología (RF10–RF12, Vista 4)</B><BR/><FONT POINT-SIZE="11">PK clave primaria · FK clave foránea · * obligatorio · pata de gallo = muchos · barra = uno · círculo = opcional · esquema eba (PostgreSQL)</FONT>>];
node [shape=plain, fontname="Arial", fontsize=10];
edge [color="#3C4043", penwidth=1.1];
